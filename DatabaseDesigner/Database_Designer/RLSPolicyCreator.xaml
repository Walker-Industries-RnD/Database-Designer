<Page x:Class="Database_Designer.RLSPolicyCreator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Database_Designer">

    <Grid Width="640" Height="1040" Background="#0E0E0E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar — section label + General toggle -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="12,4" Margin="0,0,0,2">
            <CheckBox x:Name="GeneralRlsToggle" Content="General RLS"
                      Foreground="#CCC" FontSize="11"/>
        </Border>

        <!-- ZONE 1: Policy Creator header + role cards -->
        <Border Grid.Row="1" Background="#0E0E0E" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Policy Creator" Foreground="White"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Row Level Security" Foreground="#888" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBox x:Name="NewRoleNameBox" Width="220" Height="26"
                                 Background="#1A1A1A" Foreground="White"
                                 BorderBrush="#333" BorderThickness="1"
                                 Padding="6,2" FontSize="11" Margin="0,0,8,0"
                                 PlaceholderText="Enter role name..."/>
                        <Button x:Name="CreateNewRoleBtn" Content="Create New Row"
                                Background="#262626" Foreground="White"
                                Height="26" Padding="10,0" BorderBrush="#333" BorderThickness="1"
                                FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Roles wrap into a 3-column grid via WrapPanel -->
                <WrapPanel x:Name="RoleCardsHost" Orientation="Horizontal"/>
            </StackPanel>
        </Border>

        <!-- ZONE 2: Selected role detail — table cards with role's policies -->
        <Border Grid.Row="2" Background="#0E0E0E" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Selected role summary -->
                <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="6"
                        Padding="14" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Border Width="36" Height="36" Background="#2A2A2A" CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                            <TextBlock x:Name="SelectedRolePolicyCount" Text="0 Policies"
                                       Foreground="#777" FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="SelectedRoleName" Text="No role selected"
                                   Foreground="White" FontSize="16" FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock x:Name="SelectedRoleDesc"
                                   Text="Select a role above to manage its table-level policies."
                                   Foreground="#888" FontSize="10" TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <StackPanel x:Name="SelectedRolePolicyChips"/>
                    </StackPanel>
                </Border>

                <!-- Table grid for the selected role -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox x:Name="NewPolicyTableBox" Height="26"
                                 Background="#1A1A1A" Foreground="White"
                                 BorderBrush="#333" BorderThickness="1"
                                 Padding="6,2" FontSize="11" Margin="0,0,90,0"
                                 PlaceholderText="Enter Table Name..."/>
                        <Button x:Name="CreateNewPolicyForTableBtn" Content="Create New Policy"
                                Background="#262626" Foreground="White"
                                Height="26" Padding="10,0" BorderBrush="#333" BorderThickness="1"
                                FontSize="11" HorizontalAlignment="Right" Width="120"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="TableCardsHost" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ZONE 3: Policy editor for one table — categories + per-policy rows -->
        <Border Grid.Row="3" Background="#0E0E0E" Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selected table summary -->
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Border Width="36" Height="36" Background="#2A2A2A" CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                            <TextBlock x:Name="EditorTablePolicyCount" Text="0 Policies"
                                       Foreground="#777" FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="EditorTableName" Text="No table selected"
                                   Foreground="White" FontSize="16" FontWeight="Bold"
                                   Margin="0,8,0,4"/>
                        <TextBlock x:Name="EditorTableDesc"
                                   Text="Pick a table above to edit its policies."
                                   Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                        <StackPanel x:Name="EditorTableUsageBars" Orientation="Horizontal" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Category legend — populated by RebuildPolicyEditor -->
                    <ItemsControl Grid.Column="1" Margin="20,0,0,0" x:Name="CategoryLegendHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- New-policy input -->
                <Grid Margin="0,4,0,12">
                    <TextBox x:Name="NewPolicyNameBox" Height="26"
                             Background="#1A1A1A" Foreground="White"
                             BorderBrush="#333" BorderThickness="1"
                             Padding="6,2" FontSize="11" Margin="0,0,140,0"
                             PlaceholderText="Enter Policy Name..."/>
                    <Button x:Name="CreateNewPolicyBtn" Content="Create New Policy"
                            Background="#262626" Foreground="White"
                            Height="26" Padding="10,0" BorderBrush="#333" BorderThickness="1"
                            FontSize="11" HorizontalAlignment="Right" Width="130"/>
                </Grid>

                <!-- Policy rows -->
                <ItemsControl x:Name="PolicyRowsHost"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
