<Page x:Class="Database_Designer.RLSPage3Policies"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Database_Designer">

    <Grid Background="#0E0E0E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" Padding="16,12">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="RLS Editor" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Step 3 of 3: Policies" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CloseBtn" Content="X Close" Background="#262626" Foreground="#888"
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            BorderBrush="#444" BorderThickness="1" FontSize="12"/>
                    <Button x:Name="SaveBtn" Content="Save" Background="#39A95F" Foreground="White"
                            Height="32" Padding="12,0" Margin="0,0,12,0"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"/>
                    <ComboBox x:Name="CategoryComboBox" Width="160" Height="32"
                              Background="#1A1A1A" Foreground="White"
                              BorderBrush="#333" BorderThickness="1"
                              FontSize="12">
                        <ComboBoxItem Content="Base Server" IsSelected="True"/>
                        <ComboBoxItem Content="Profiles"/>
                        <ComboBoxItem Content="Communication"/>
                        <ComboBoxItem Content="Economy"/>
                    </ComboBox>
                    <TextBox x:Name="NewPolicyNameBox" Width="180" Height="32"
                             Background="#1A1A1A" Foreground="White"
                             BorderBrush="#333" BorderThickness="1"
                             Padding="8,4" FontSize="12" Margin="8,0,0,0"
                             PlaceholderText="Policy name..."/>
                    <Button x:Name="CreateNewPolicyBtn" Content="Add Policy"
                            Background="#39A95F" Foreground="White"
                            Height="32" Padding="16,0" Margin="8,0,0,0"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="8"
                    Padding="20" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock x:Name="TableNameText" Text="No table selected"
                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="TableDescText"
                               Text="Select a table from page 2"
                               Foreground="#888" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,16"/>
                    <TextBlock x:Name="TableStatsText" Text="0 policies"
                               Foreground="#39A95F" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="Categories" Foreground="#666" FontSize="11"
                               Margin="0,16,0,8"/>
                    <ItemsControl x:Name="CategoryLegendHost"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PolicyRowsHost"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyStateText" Text="No policies yet. Create one to get started."
                           Foreground="#555" FontSize="14" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#1A1A1A" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackBtn" Content="← Back: Tables"
                            Background="#262626" Foreground="#CCC"
                            Height="36" Padding="16,0"
                            BorderBrush="#444" BorderThickness="1" FontSize="13"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Edit policies for your table"
                           Foreground="#888" FontSize="12" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>