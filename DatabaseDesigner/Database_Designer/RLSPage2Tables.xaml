<Page x:Class="Database_Designer.RLSPage2Tables"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Database_Designer">

    <Grid Background="#0E0E0E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" Padding="16,12">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="RLS Editor" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Step 2 of 3: Tables" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CloseBtn" Content="X Close" Background="#262626" Foreground="#888"
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            BorderBrush="#444" BorderThickness="1" FontSize="12"/>
                    <Button x:Name="SaveBtn" Content="Save" Background="#39A95F" Foreground="White"
                            Height="32" Padding="12,0" Margin="0,0,12,0"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="NewTableNameBox" Width="220" Height="32"
                             Background="#1A1A1A" Foreground="White"
                             BorderBrush="#333" BorderThickness="1"
                             Padding="8,4" FontSize="12"
                             PlaceholderText="Enter table name..."/>
                    <Button x:Name="CreateNewTableBtn" Content="Create Table"
                            Background="#7B3CFF" Foreground="White"
                            Height="32" Padding="16,0" Margin="8,0,0,0"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="8"
                    Padding="20" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock x:Name="RoleNameText" Text="No role selected"
                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="RoleDescText"
                               Text="Select a role from page 1"
                               Foreground="#888" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,16"/>
                    <TextBlock x:Name="RoleStatsText" Text="0 tables, 0 policies"
                               Foreground="#FF4C4C" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="TableCardsHost" Orientation="Horizontal"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyStateText" Text="No tables yet. Create one to get started."
                           Foreground="#555" FontSize="14" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#1A1A1A" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackBtn" Content="← Back: Roles"
                            Background="#262626" Foreground="#CCC"
                            Height="36" Padding="16,0" Margin="0,0,12,0"
                            BorderBrush="#444" BorderThickness="1" FontSize="13"/>
                    <TextBlock x:Name="StatusText" Text="Select a table to continue"
                               Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NextBtn" Content="Next: Policies →"
                            Background="#7B3CFF" Foreground="White"
                            Height="36" Padding="24,0"
                            BorderThickness="0" FontSize="13" FontWeight="Bold"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>