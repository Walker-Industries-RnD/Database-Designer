<Window x:Class="Database_Designer.NodeWalker.ScriptToNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script to Node"
        Width="500" Height="400">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Paste C# method signature:" 
                   Foreground="#CFC7B2"
                   FontSize="14" 
                   Margin="0,0,0,10"
                   FontFamily="/Database_Designer;component/Assets/Fonts/Inter/Inter_28pt-ThinItalic.ttf#Inter 28pt Thin"/>

        <!-- Input -->
        <TextBox x:Name="SignatureInput" Grid.Row="1" 
                 Background="#2A2A2A"
                 Foreground="#E6E2D6"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="80"
                 Padding="10"
                 BorderBrush="#AFA58C"
                 BorderThickness="1"/>

        <!-- Preview -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">

            <TextBlock Text="Preview:" 
                       Foreground="#AFA58C"
                       FontSize="12"
                       Margin="0,0,0,5"
                       FontFamily="/Database_Designer;component/Assets/Fonts/Inter/Inter_28pt-ThinItalic.ttf#Inter 28pt Thin"/>

            <TextBlock x:Name="PreviewText"
                       Foreground="#8F8A7C"
                       FontSize="11"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <!-- Button -->
        <Button Grid.Row="3" Content="Create Node" 
                Background="#AFA58C"
                Foreground="#1C1C1C"
                FontFamily="/Database_Designer;component/Assets/Fonts/Inter/Inter_28pt-ThinItalic.ttf#Inter 28pt Thin"
                FontSize="14"
                Padding="15,8"
                HorizontalAlignment="Right"
                Click="CreateNode_Click"/>

    </Grid>
</Window>