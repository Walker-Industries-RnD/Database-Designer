<UserControl
    x:Class="Database_Designer.NodeWalker.NodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DesignWidth="1360" d:DesignHeight="768" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border x:Name="NodeBorder"
            CornerRadius="10"
            BorderBrush="#FF3F352F"
            BorderThickness="3" Background="#00C1AE9F">
        <Grid Background="#FF74665D">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <Border Grid.Row="0" Padding="12,10" Background="#FF3F352F">
                <TextBlock x:Name="TitleBlock"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="/Database_Designer;component/Assets/Fonts/Inter/Inter_28pt-ThinItalic.ttf#Inter 28pt Thin"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1"
                    Background="#1A1A1A"
                    Padding="10,4"
                    Visibility="{Binding HasValuePreview,                                          RelativeSource={RelativeSource AncestorType=UserControl},                                          Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="ValuePreviewBlock"
                           Text="{Binding ValuePreview, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#98C379"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220"/>
            </Border>

            <!-- Warning row — FIXED: Visibility now bound so it collapses when HasWarning=false -->
            <Border Grid.Row="1"
                    Padding="12,8"
                    Visibility="{Binding HasWarning,                                          RelativeSource={RelativeSource AncestorType=UserControl},                                          Converter={StaticResource BoolToVis}}" Background="#FF3F352F">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="20" Foreground="#FFEE8C" Margin="0,0,10,0"/>
                    <TextBlock x:Name="WarningBlock"
                               Text="{Binding WarningText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-BoldItalic.ttf#Inter 28pt"
                               FontSize="13"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Port rows -->
            <Grid Grid.Row="2" Margin="12,12,12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="InputsPanel"  Grid.Column="0" Background="#00262626"/>
                <StackPanel x:Name="OutputsPanel" Grid.Column="2" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
