<Page x:Class="Database_Designer.NodeWalker.NodeWalkerWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Foreground="{DynamicResource Theme_TextBrush}"
      Background="#1C1C1C"
      d:DesignWidth="1417" d:DesignHeight="768">

    <Grid>
        <Image Source="/Database_Designer;component/assets/images/darkbg.png"
               Stretch="UniformToFill"
               Opacity="1"
               IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1F1F1F">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Canvas Grid.Row="0" Height="85">
                        <Canvas.Background>
                            <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}"/>
                        </Canvas.Background>
                        <Image Source="/Database_Designer;component/assets/nodewalker/nodewlkr.png"
                               Width="74" Height="88" Margin="10,0,0,0"/>
                        <TextBlock Text="NODEWLKR"
                                   Canvas.Left="80" Canvas.Top="24"
                                   FontSize="21"
                                   FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                   Foreground="#E6E2D6"/>
                        <TextBlock Text="API Creator"
                                   Canvas.Left="80" Canvas.Top="48"
                                   FontSize="13"
                                   FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                   Foreground="#8C877C"/>
                    </Canvas>

                    <ScrollViewer Grid.Row="1" x:Name="UIScroll" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}"/>
                    </Border.Background>

                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <Button x:Name="CreateInputButton" Content="+ Input" Margin="5" Height="29" Width="80"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#6E8B6A" Foreground="#1C1C1C" BorderThickness="0"/>
                            <Button x:Name="PushOutputButton" Content="+ Output" Margin="5" Height="29" Width="80"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#6A7F8B" Foreground="#1C1C1C" BorderThickness="0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="fn"
                                       Foreground="#8C877C" VerticalAlignment="Center"
                                       FontSize="12" Margin="0,0,6,0"
                                       FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"/>
                            <TextBox x:Name="FunctionNameBox" Width="200" Height="26"
                                     Background="#2A2A2A" Foreground="#E6E2D6"
                                     BorderBrush="#AFA58C" BorderThickness="1"
                                     Padding="6,2" FontFamily="Consolas" FontSize="12"
                                     VerticalContentAlignment="Center"/>
                            <CheckBox x:Name="AsyncCheck" Content="async"
                                      Foreground="#CFC7B2" Margin="10,0,0,0"
                                      VerticalAlignment="Center" FontSize="12"
                                      FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                            <Button x:Name="FrameButton" Content="Frame" Margin="5" Height="29" Width="70"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#3A3A3A" Foreground="#E6E2D6" BorderThickness="0"
                                    ToolTipService.ToolTip="Recenter the layout in the viewport"/>
                            <Button x:Name="SaveButton" Content="Save" Margin="5" Height="29" Width="70"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#AFA58C" Foreground="#1C1C1C" BorderThickness="0"/>
                            <Button x:Name="LoadButton" Content="Load" Margin="5" Height="29" Width="70"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#3A3A3A" Foreground="#E6E2D6" BorderThickness="0"/>
                            <Button x:Name="RefreshButton" Content="Refresh" Margin="5" Height="29" Width="80"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#3A3A3A" Foreground="#E6E2D6" BorderThickness="0"/>
                            <Button x:Name="ReplaceButton" Content="Replace" Margin="5" Height="29" Width="80"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#3A3A3A" Foreground="#E6E2D6" BorderThickness="0"/>
                            <Button x:Name="ViewCodeButton" Content="View Code" Margin="5" Height="29" Width="100"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12" Background="#3A3A3A" Foreground="#E6E2D6" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" x:Name="WorkspaceClip">
                    <Canvas x:Name="ChunksCanvas" Background="Transparent"/>
                    <Canvas x:Name="WorkspaceCanvas" Background="Transparent"/>
                    <Canvas x:Name="ConnectionsCanvas" Background="{x:Null}"/>
                    <Canvas x:Name="NotesCanvas"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="2" Background="#1F1F1F">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#232323" Padding="15,10">
                        <TextBlock Text="Node Inspector"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#E6E2D6"
                                   FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"/>
                    </Border>

                    <Border x:Name="NoSelectionPlaceholder" Grid.Row="1"
                            Visibility="Visible">
                        <TextBlock Text="Select a node to inspect it."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#6E6A60"
                                   FontSize="13"
                                   FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"/>
                    </Border>

                    <ScrollViewer x:Name="NodeInspector" Grid.Row="1"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="15">
                            <TextBlock x:Name="InspectorTitle"
                                       Text="Node"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#E6E2D6"
                                       FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                       Margin="0,0,0,4"/>

                            <TextBlock x:Name="InspectorDesc"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#8C877C"
                                       TextWrapping="Wrap"
                                       FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                       Margin="0,0,0,16"/>

                            <Button Content="Delete Node"
                                    Height="30"
                                    Background="#AFA58C" Foreground="#1C1C1C"
                                    BorderThickness="0"
                                    FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                    FontSize="12"
                                    Margin="0,0,0,20"/>

                            <StackPanel x:Name="InspectorValuePanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <TextBlock Text="VALUE"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#AFA58C"
                                           FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="InspectorValueHint"
                                           FontSize="10"
                                           Foreground="#8C877C"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="InspectorValueBox"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="#1E1E1E" Foreground="#98C379"
                                         BorderBrush="#3A3A3A" BorderThickness="1"
                                         Padding="8,6" Height="100"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <TextBlock Text="INPUTS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#AFA58C"
                                       FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                       Margin="0,0,0,6"/>
                            <Border Background="#2A2A2A" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                                <ItemsControl x:Name="InspectorInputs"/>
                            </Border>

                            <TextBlock Text="OUTPUTS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#AFA58C"
                                       FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
                                       Margin="0,0,0,6"/>
                            <Border Background="#2A2A2A" CornerRadius="6" Padding="10">
                                <ItemsControl x:Name="InspectorOutputs"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="MaximizeButton" Content="□" Height="29" Width="40"
        FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
        FontSize="12" Background="#3A3A3A" Foreground="#E6E2D6"
        BorderThickness="0"
        Click="MaximizeButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,60,0"/>

                    <Button x:Name="CloseButton" Content="✕" Height="29" Width="40"
        FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"
        FontSize="12" Background="#AFA58C" Foreground="#1C1C1C"
        BorderThickness="0"
        Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>

                <Border x:Name="CodeViewerPanel"
                        Background="#0D1117"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#161B22" Padding="14,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#AFA58C"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Generated C#"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#E6E2D6"
                                               FontFamily="/Database_Designer;component/Assets/Fonts/Inter_28pt-Light.ttf#Inter 28pt"/>
                                </StackPanel>
                                <Button Content="✕"
                                        HorizontalAlignment="Right"
                                        Width="24" Height="24"
                                        FontSize="11"
                                        Background="Transparent" Foreground="#8C877C"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CloseCodeViewer_Click"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="#0D1117">

                            <TextBlock x:Name="CodeViewerText"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#E6E2D6"
                                       TextWrapping="NoWrap"
                                       Padding="16"/>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#161B22" Padding="14,6">
                            <Grid>
                                <TextBlock x:Name="CodeStatusBar"
                                           Text="0 lines"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#8C877C"
                                           VerticalAlignment="Center"/>
                                <Button Content="⎘ Copy"
                                        HorizontalAlignment="Right"
                                        Padding="10,3"
                                        BorderThickness="1"
                                        BorderBrush="#3A3A3A"
                                        Background="#232323"
                                        Foreground="#E6E2D6"
                                        FontFamily="Consolas" FontSize="11"
                                        Cursor="Hand"
                                        Click="CopyCode_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Page>