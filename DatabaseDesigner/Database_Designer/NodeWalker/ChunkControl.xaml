<UserControl x:Class="Database_Designer.NodeWalker.ChunkControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="620" 
             Height="420"
             d:DesignWidth="620" d:DesignHeight="420">

    <Grid>
        <!-- Main Chunk Border -->
        <Border x:Name="MainBorder" 
                BorderBrush="#FF4C4C" 
                BorderThickness="4" 
                CornerRadius="12"
                Padding="12" Background="#FFC1AFA0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

<!-- Header -->
                <Border 
                        CornerRadius="8" 
                        Padding="16,12" Background="#FF3F352F">
                    <TextBlock x:Name="TitleText"
                               Text="Does A Cool Thing" 
                               FontFamily="/Database_Designer;component/Assets/Fonts/Inter/Inter_28pt-ThinItalic.ttf#Inter 28pt Thin"
                               FontSize="19" 
                               Foreground="#FFFFFF"
                               Cursor="Hand" />
                </Border>

                <!-- Inner Canvas Area -->
                <ScrollViewer Grid.Row="1" 
                              Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <Canvas x:Name="InnerCanvas" 
                            Background="Transparent"
                            MinWidth="400"
                            MinHeight="200" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Resize Thumb (bottom-right corner) -->
        <Thumb x:Name="ResizeThumb"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Width="24"
               Height="24"
               Margin="0,0,4,4"
               Cursor="SizeNWSE"
               Opacity="0.6">
            <Thumb.Template>
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Path Data="M 0,18 L 18,18 L 18,0" 
                              Stroke="#FF4C4C" 
                              StrokeThickness="3" 
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>