<Window x:Class="Database_Designer.NodeWalker.NodeLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Node Library" 
        Height="560" 
        Width="420">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Box -->
        <Border Background="#2A2A2A" 
                BorderBrush="#B8A98A" 
                BorderThickness="1" 
                CornerRadius="4" 
                Margin="0,0,0,12">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Height="36"
                         FontSize="14"
                         Background="Transparent"
                         Foreground="#E6E2D6"
                         BorderThickness="0"
                         Padding="12,8"
                         TextChanged="SearchBox_TextChanged"
                         VerticalContentAlignment="Center"/>

                <TextBlock x:Name="SearchWatermark"
                           Text="Search nodes..."
                           Foreground="#8C877C"
                           Margin="12,8"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- TreeView -->
        <TreeView x:Name="LibraryTree" 
                  Grid.Row="1"
                  Background="#232323"
                  BorderBrush="#B8A98A"
                  BorderThickness="1"
                  Padding="4"
                  FontSize="14"
                  Foreground="#E6E2D6"
                  MouseDoubleClick="LibraryTree_MouseDoubleClick"/>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,16,0,0">

            <Button Content="Add Selected" 
                    Width="120" 
                    Height="34"
                    Background="#B8A98A" 
                    Foreground="#1C1C1C"
                    FontSize="13"
                    Click="AddButton_Click"/>

            <Button Content="Cancel" 
                    Width="100" 
                    Height="34" 
                    Margin="10,0,0,0"
                    Background="#3A3A3A" 
                    Foreground="#E6E2D6"
                    FontSize="13"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>