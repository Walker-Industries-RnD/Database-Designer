<Page x:Class="Database_Designer.FunctionCreator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Database_Designer">

    <Grid Width="640" Height="1040" Background="#0E0E0E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" Padding="12,4" Margin="0,0,0,2">
            <CheckBox x:Name="GeneralFunctionsToggle" Content="General Functions"
                      Foreground="#CCC" FontSize="11"/>
        </Border>

        <!-- ZONE 1: Function Creator header + module cards -->
        <Border Grid.Row="1" Background="#0E0E0E" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Function Creator" Foreground="White"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="API Functions" Foreground="#888" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBox x:Name="NewModuleNameBox" Width="220" Height="26"
                                 Background="#1A1A1A" Foreground="White"
                                 BorderBrush="#333" BorderThickness="1"
                                 Padding="6,2" FontSize="11" Margin="0,0,8,0"
                                 PlaceholderText="Enter module name..."/>
                        <Button x:Name="CreateNewModuleBtn" Content="Create New Module"
                                Background="#262626" Foreground="White"
                                Height="26" Padding="10,0" BorderBrush="#333" BorderThickness="1"
                                FontSize="11"/>
                    </StackPanel>
                </Grid>
                <WrapPanel x:Name="ModuleCardsHost" Orientation="Horizontal"/>
            </StackPanel>
        </Border>

        <!-- ZONE 2: Selected module — endpoint cards -->
        <Border Grid.Row="2" Background="#0E0E0E" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="6"
                        Padding="14" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Border Width="36" Height="36" Background="#2A2A2A" CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                            <TextBlock x:Name="SelectedModuleFnCount" Text="0 Functions"
                                       Foreground="#777" FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="SelectedModuleName" Text="No module selected"
                                   Foreground="White" FontSize="16" FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock x:Name="SelectedModuleDesc"
                                   Text="Select a module above to see its endpoints."
                                   Foreground="#888" FontSize="10" TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <StackPanel x:Name="SelectedModuleFnChips"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox x:Name="NewEndpointNameBox" Height="26"
                                 Background="#1A1A1A" Foreground="White"
                                 BorderBrush="#333" BorderThickness="1"
                                 Padding="6,2" FontSize="11" Margin="0,0,150,0"
                                 PlaceholderText="Enter Endpoint Name..."/>
                        <Button x:Name="CreateNewEndpointBtn" Content="Create New Endpoint"
                                Background="#262626" Foreground="White"
                                Height="26" Padding="10,0" BorderBrush="#333" BorderThickness="1"
                                FontSize="11" HorizontalAlignment="Right" Width="140"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="EndpointCardsHost" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ZONE 3: Endpoint editor — verbs + per-function rows -->
        <Border Grid.Row="3" Background="#0E0E0E" Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Border Width="36" Height="36" Background="#2A2A2A" CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                            <TextBlock x:Name="EditorEndpointFnCount" Text="0 Functions"
                                       Foreground="#777" FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="EditorEndpointName" Text="No endpoint selected"
                                   Foreground="White" FontSize="16" FontWeight="Bold"
                                   Margin="0,8,0,4"/>
                        <TextBlock x:Name="EditorEndpointDesc"
                                   Text="Pick an endpoint above to edit its functions."
                                   Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                        <StackPanel x:Name="EditorEndpointUsageBars" Orientation="Horizontal" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ItemsControl Grid.Column="1" Margin="20,0,0,0" x:Name="VerbLegendHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <Grid Margin="0,4,0,12">
                    <TextBox x:Name="NewFunctionNameBox" Height="26"
                             Background="#1A1A1A" Foreground="White"
                             BorderBrush="#333" BorderThickness="1"
                             Padding="6,2" FontSize="11" Margin="0,0,150,0"
                             PlaceholderText="Enter Function Name..."/>
                    <Button x:Name="CreateNewFunctionBtn" Content="Create New Function"
                            Background="#262626" Foreground="White"
                            Height="26" Padding="10,0" BorderBrush="#333" BorderThickness="1"
                            FontSize="11" HorizontalAlignment="Right" Width="140"/>
                </Grid>

                <ItemsControl x:Name="FunctionRowsHost"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
