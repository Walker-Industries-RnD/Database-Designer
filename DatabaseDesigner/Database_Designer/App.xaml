<Application
    x:Class="Database_Designer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Database_Designer">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Clean white palette = the app's baseline ("Default") theme. These
                 three keys drive every themed surface in the app (SolidColorBrush
                 Color="{DynamicResource ...}" in XAML, ThemeManager.ResolveBrush in
                 C#). ThemeManager overrides them at runtime when a theme is applied.
                 *Color keys are Colors; *Brush keys are Brushes. -->
            <Color x:Key="Theme_BackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="Theme_TextOnPrimaryColor">#FF1D1D1D</Color>
            <SolidColorBrush x:Key="Theme_TextBrush" Color="#FF1D1D1D" />
        </ResourceDictionary>
    </Application.Resources>
    <Application.Theme>
        <mt:ModernTheme CurrentPalette="Dark" xmlns:mt="http://opensilver.net/themes/modern" />
    </Application.Theme>
</Application>
