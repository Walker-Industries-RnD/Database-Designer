<Page x:Class="Database_Designer.RLSPage1Roles"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Database_Designer">

    <Grid Background="#0E0E0E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" Padding="16,12">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="RLS Editor" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Step 1 of 3: Roles" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CloseBtn" Content="X Close" Background="#262626" Foreground="#888"
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            BorderBrush="#444" BorderThickness="1" FontSize="12"/>
                    <Button x:Name="SaveBtn" Content="Save" Background="#39A95F" Foreground="White"
                            Height="32" Padding="12,0" Margin="0,0,12,0"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="NewRoleNameBox" Width="220" Height="32"
                             Background="#1A1A1A" Foreground="White"
                             BorderBrush="#333" BorderThickness="1"
                             Padding="8,4" FontSize="12"
                             PlaceholderText="Enter role name..."/>
                    <Button x:Name="CreateNewRoleBtn" Content="Create Role"
                            Background="#FF4C4C" Foreground="White"
                            Height="32" Padding="16,0" Margin="8,0,0,0"
                            BorderThickness="0" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <WrapPanel x:Name="RoleCardsHost" Orientation="Horizontal"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#1A1A1A" Padding="16,12">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Select a role to continue"
                           Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NextBtn" Content="Next: Tables →"
                            Background="#FF4C4C" Foreground="White"
                            Height="36" Padding="24,0"
                            BorderThickness="0" FontSize="13" FontWeight="Bold"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>