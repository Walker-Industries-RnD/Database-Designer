<Page
    x:Class="Database_Designer.DLC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Database_Designer">


    <Grid x:Name="DesignerTemplatesUI" MaxWidth="1270" MaxHeight="920" MinHeight="920" Width="1270" MinWidth="1310" Visibility="Visible"  >


        <StackPanel VerticalAlignment="Center" MinHeight="920" MaxHeight="1310" Visibility="Visible">
            <Grid MinHeight="40">
                <Rectangle Fill="#454138" Stroke="Transparent" Height="40" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" MinWidth="500" HorizontalAlignment="Left">
                    <Image Margin="8,4,4,4"
    Source="Assets/Images/WILogoNoText.png"
    HorizontalAlignment="Left"
    MaxHeight="30" MinWidth="30" MinHeight="30" MaxWidth="30" />
                    <TextBlock Foreground="#FFFFFF"
        FontSize="18"
        FontFamily="Assets\Fonts\Inter_28pt-Light.ttf"
        VerticalAlignment="Center"
        Text="DLLs" IsEnabled="True" />
                </StackPanel>
                <StackPanel Width="71" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,-3" Height="39" >
                    <Button Name = "ExitButton" Content="X" Width="36" FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" Background="#FFDCD8C0" HorizontalAlignment="Right" Height="37" >
                        <Button.Foreground>
                            <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </Grid>


            <Grid VerticalAlignment="Top" MinHeight="880" MaxHeight="220" Visibility="Visible">
                <Image Stretch="Fill"
                   VerticalAlignment="Top"
                   MinHeight="880" MaxHeight="220"
                   Source="Assets/Images/BGBlack.png" Visibility="Visible" />
                <Grid MinWidth="220" Name="InitialD" Visibility="Visible">
                    <ScrollViewer HorizontalAlignment="Right" VerticalAlignment="Top" Width="800" Height="848" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,0,50,0" Name="ProjectsListViewer" >
                        <StackPanel Orientation="Vertical" Background="#00D4D4D4" Name="DLCList" HorizontalAlignment="Center" Width="768" >
                            <StackPanel Orientation="Horizontal" Height="48" ProgressiveRenderingChunkSize="5" Visibility="Collapsed">
                                <TextBox Text="Type A Project's Name/Description Here" Padding="10" 
          VerticalAlignment="Center" Width="652" Height="40"
          FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" SelectionStart="8" SelectionLength="1" PlaceholderText="Enter A Table Name" AcceptsTab="False" FontSize="14" Margin="0,0,0,0" Background="#DB464239" Name="SearchBar"/>
                                <ToggleButton Width="79" Margin="10,0,0,0" Content="Favorites" Background="#FF454138" Height="39" Name="Favorites" FontSize="13" Visibility="Collapsed"/>

                                <Button Width="100" Margin="10,0,0,0" Content="Search" Background="#FF454138" Height="39" Name="TableViewSearch" FontSize="13"/>

                            </StackPanel>

                            <Grid HorizontalAlignment="Left" Width="786" Height="264" Background="#FFF0F0F0" Visibility="Collapsed" >
                                <Image Source="/Database_Designer;component/assets/images/bg.png" Margin="0,0,0,0" Stretch="Fill" />
                                <StackPanel Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="784" Height="40" Orientation="Horizontal" Background="#FF454138" >
                                    <Rectangle Width="28" Stroke="Gray" StrokeThickness="1" Height="28" Fill="#FF2C2B28" Margin="10,0,0,0" />
                                    <TextBlock Text="Project AWCE - XOEC - XO35 - 4EO0" FontSize="18" FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" Height="23" Margin="6,0,0,0" >
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                                <Rectangle Margin="24,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="168" Height="168" Stroke="Gray" StrokeThickness="1" Fill="#FF454138" />
                                <Image Source="/Database_Designer;component/assets/images/whitelogo.png" Margin="40,80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="144" Height="136" />
                                <TextBlock Text="Yorha Unit Database BAM1" FontSize="26" FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-80,-96,-240,-8" Width="528" >
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="A Database Containing Data Regarding The Actions Of Yorha Operation“BECOME AS MAN” " FontSize="20" FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="168,8,-8,-32" Width="536" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" >
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Button Content="Open Project" Margin="208,192,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="248" Height="32" Background="#FF9D9785" FontSize="13" >
                                    <Button.Foreground>
                                        <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                                    </Button.Foreground>
                                </Button>
                                <Button Content="Edit Project" Margin="464,192,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="248" Height="32" Background="#FF9D9785" FontSize="13" >
                                    <Button.Foreground>
                                        <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                                    </Button.Foreground>
                                </Button>

                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="433" Height="864" >
                        <Grid.Background>
                            <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                        </Grid.Background>
                        <Image Source="/Database_Designer;component/assets/images/dlc/dlcbg.png" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="433" Height="768" />
                        <Image Source="/Database_Designer;component/assets/images/masuki/nerd.png" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="440" Name="VNImg" Margin="0,0,0,140" />
                        <TextBlock Text="Masuisuki: This is what we call a level 67 tung rung rung sahir flowkenuinely brainrot" FontSize="14" Margin="8,752,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="56" TextWrapping="Wrap" Width="408" FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" TextAlignment="Center" Name="VNText" >
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                        <Button Content="Continue" Margin="8,816,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="416" Height="32" Name="Continue" >
                            <Button.Foreground>
                                <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                            </Button.Foreground>
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                            </Button.Background>
                        </Button>
                    </Grid>

                </Grid>
                <Grid Background="#00F0F0F0" Name="DetailedDLC" Visibility="Collapsed" >
                    <Image Source="/Database_Designer;component/assets/images/dlc/header.png" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1384" Height="608" Name="HeaderImg" />
                    <TextBlock Text="Meet the minds behind Database Designer: In this supporter's pack, get an exclusive Visual Novel-style interview explaining the thought processes and development behind the free software!It’s a fully styled Visual Novel experience that drops you into the actual development process of Database Designer.This includes decisions, arguments, design philosophy, and the moments where things almost went completely off the rails." FontSize="16" Margin="24,656,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="176" Width="704" TextWrapping="Wrap" FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" Name="DLCInfoText" >
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                        </TextBlock.Foreground>
                    </TextBlock>
                    <StackPanel Margin="800,624,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="472" Height="216" Orientation="Vertical" Background="#00D4D4D4" >
                        <Button Content="Launch" Margin="8,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Top" Width="416" Height="42" Name="LaunchBtn" >
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                            </Button.Background>
                            <Button.Foreground>
                                <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                            </Button.Foreground>
                        </Button>
                        <Button Content="Get The Supporter's Pack!" Margin="8,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Top" Width="416" Height="42" Name="VIsitStore" >
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                            </Button.Background>
                            <Button.Foreground>
                                <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                            </Button.Foreground>
                        </Button>
                        <Button Content="Go Back" Margin="8,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Top" Width="416" Height="42" Name="BackBtn" >
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                            </Button.Background>
                            <Button.Foreground>
                                <SolidColorBrush Color="{DynamicResource Theme_BackgroundColor}" />
                            </Button.Foreground>
                        </Button>
                        
                    </StackPanel>
                    <TextBlock Text="TextBlock" FontSize="18" Margin="24,616,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="712" FontFamily="Assets\Fonts\Inter_28pt-Light.ttf" Name="Title" >
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{DynamicResource Theme_TextOnPrimaryColor}" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
            </Grid>
        </StackPanel>
    
    
    
    
    
    
    </Grid>


</Page>
